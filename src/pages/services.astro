---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';

const services = [
  {
    title: "Installation électrique neuve",
    description: "Nous concevons et réalisons l'installation électrique complète de votre construction neuve, de l'étude à la mise en service.",
    items: ["Étude et dimensionnement", "Pose du tableau électrique", "Câblage et raccordement", "Mise en service et certification Consuel", "Conformité NF C 15-100"],
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 0h.008v.008h-.008V7.5z" />`,
  },
  {
    title: "Rénovation & mise aux normes",
    description: "Votre installation a plus de 15 ans ? Nous la mettons en conformité avec les normes actuelles pour garantir votre sécurité.",
    items: ["Diagnostic de l'installation existante", "Remplacement du tableau électrique", "Mise à la terre", "Remplacement des prises et interrupteurs", "Certificat de conformité"],
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`,
  },
  {
    title: "Dépannage & urgences",
    description: "Une panne électrique peut survenir à tout moment. Nous intervenons rapidement sur Grenoble et son agglomération, 7 jours sur 7.",
    items: ["Recherche de panne", "Remplacement de disjoncteur", "Réparation de court-circuit", "Remise en service rapide", "Intervention 7j/7"],
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />`,
  },
  {
    title: "Domotique & maison connectée",
    description: "Simplifiez votre quotidien avec des solutions intelligentes : éclairage connecté, volets motorisés, gestion à distance.",
    items: ["Éclairage intelligent (scènes, minuteries)", "Volets roulants motorisés", "Thermostat connecté", "Contrôle à distance (smartphone)", "Intégration multi-marques"],
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />`,
  },
  {
    title: "Éclairage intérieur & extérieur",
    description: "Valorisez votre habitat avec un éclairage sur mesure : spots encastrés, luminaires design, éclairage de jardin et terrasse.",
    items: ["Spots LED encastrés", "Éclairage architectural", "Mise en lumière extérieure", "Détecteurs de présence", "Variateurs d'ambiance"],
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />`,
  },
  {
    title: "Borne de recharge",
    description: "Installez une borne de recharge pour véhicule électrique à domicile. Nous vous accompagnons du choix à l'installation.",
    items: ["Étude de faisabilité", "Installation borne 7 kW à 22 kW", "Raccordement au tableau", "Mise en conformité", "Aide aux démarches de subvention"],
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M21 10.5h.375c.621 0 1.125.504 1.125 1.125v2.25c0 .621-.504 1.125-1.125 1.125H21M3.75 18h15A2.25 2.25 0 0021 15.75v-6a2.25 2.25 0 00-2.25-2.25h-15A2.25 2.25 0 001.5 9.75v6A2.25 2.25 0 003.75 18z" />`,
  },
];
---

<Layout title="Nos Services — Éclat Électricité">
  <Header />
  <main>
    <PageHero title="Nos Services" subtitle="Des solutions adaptées à chaque besoin" />

    {services.map((service, i) => (
      <section class={i % 2 === 0 ? "bg-cloud py-16 md:py-20" : "bg-cloud-dark py-16 md:py-20"}>
        <div class="max-w-6xl mx-auto px-6">
          <div class="flex flex-col md:flex-row gap-10 items-start">
            <div class="md:w-1/3 shrink-0">
              <div class="sticky top-24">
                <div class="w-16 h-16 bg-blue/10 rounded-2xl flex items-center justify-center mb-4">
                  <svg class="w-8 h-8 text-blue" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <Fragment set:html={service.icon} />
                  </svg>
                </div>
                <h2 class="font-heading text-2xl md:text-3xl font-bold">{service.title}</h2>
              </div>
            </div>
            <div class="md:w-2/3">
              <p class="text-slate text-lg leading-relaxed mb-6">{service.description}</p>
              <ul class="space-y-3">
                {service.items.map((item) => (
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-electric shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    <span class="text-graphite">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>
    ))}

    <section class="bg-midnight py-12">
      <div class="max-w-6xl mx-auto px-6 text-center">
        <p class="text-white text-lg font-heading font-bold mb-4">Un projet en tête ?</p>
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-8 py-4 bg-electric text-midnight font-bold rounded-xl hover:bg-electric-dark transition-colors duration-200"
        >
          Demander un devis gratuit
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
