---
const navLinks = [
  { label: "Accueil", href: "/" },
  { label: "Nos Services", href: "/services" },
  { label: "L'entreprise", href: "/a-propos" },
  { label: "Contact", href: "/contact" },
];
---

<footer class="bg-midnight text-slate-light">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      <div>
        <a href="/" class="inline-flex items-center gap-2 mb-4">
          <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none">
            <path d="M13 2L4.5 13h5l-1 9 8.5-11h-5l1-9z" fill="#FACC15"/>
          </svg>
          <span class="font-heading text-lg font-bold">
            <span class="text-white">Éclat</span>
            <span class="text-electric ml-1">Électricité</span>
          </span>
        </a>
        <p class="text-sm leading-relaxed mb-4">
          Électricien certifié depuis 2018.<br />
          Installation, rénovation, dépannage.<br />
          Grenoble et agglomération.
        </p>
        <p class="text-xs text-slate-light/60">
          Qualifelec · RGE · Garantie décennale
        </p>
      </div>

      <div>
        <h4 class="font-heading text-white text-lg font-bold mb-4">Navigation</h4>
        <ul class="flex flex-col gap-3">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm hover:text-electric transition-colors duration-200">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-heading text-white text-lg font-bold mb-4">Contact</h4>
        <div class="flex flex-col gap-3 text-sm">
          <p>12 avenue de la Technologie<br />38000 Grenoble</p>
          <p>
            <a href="tel:0476000000" class="text-electric hover:text-electric-dark transition-colors duration-200 font-semibold">
              04 76 00 00 00
            </a>
          </p>
          <p>contact@eclat-electricite.fr</p>
          <p class="text-xs text-slate-light/60 mt-2">
            Lun–Ven : 8h–18h · Urgences 7j/7
          </p>
        </div>
      </div>
    </div>

    <div class="border-t border-midnight-light pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs">&copy; 2026 Éclat Électricité. Tous droits réservés.</p>
      <p class="text-xs">
        Site réalisé par
        <a href="https://mouilleronweb.fr" target="_blank" rel="noopener noreferrer" class="text-electric hover:text-electric-dark transition-colors duration-200">
          Mouilleron Web
        </a>
      </p>
    </div>
  </div>
</footer>
